@model IEnumerable<FerticaStockManagement.ViewModels.StockMovementViewModel>

@{
    ViewData["Title"] = "Mouvements de stock";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title mb-1">
                <i class="bi bi-arrow-left-right me-2"></i>
                Mouvements de stock
            </h1>
            <p class="text-muted mb-0">
                Historique des entrées et sorties de stock
            </p>
        </div>

        <a asp-controller="Inventory"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-boxes me-1"></i>
            Inventaire
        </a>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    Historique des mouvements
                </h5>

                <span class="badge bg-secondary">
                    @Model.Count() mouvement(s)
                </span>

            </div>
        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Référence</th>
                                <th>Type</th>
                                <th>Article</th>
                                <th>Quantité</th>
                                <th>Stock avant</th>
                                <th>Stock après</th>
                                <th>Date</th>
                                <th>Créé par</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var movement in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @movement.Reference
                                        </strong>
                                    </td>

                                    <td>
                                        @if (movement.MovementType == "Entrée")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-arrow-down-circle me-1"></i>
                                                Entrée
                                            </span>
                                        }
                                        else if (movement.MovementType == "Sortie")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-arrow-up-circle me-1"></i>
                                                Sortie
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @movement.MovementType
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @movement.ItemName
                                        </div>

                                        @if (movement.RawMaterialId.HasValue)
                                        {
                                            <small class="text-muted">
                                                Matière première
                                            </small>
                                        }
                                        else if (movement.ProductId.HasValue)
                                        {
                                            <small class="text-muted">
                                                Produit
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        <strong>
                                            @movement.Quantity.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @movement.StockBefore.ToString("N2")
                                    </td>

                                    <td>
                                        <strong>
                                            @movement.StockAfter.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @movement.MovementDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(movement.CreatedBy))
                                        {
                                            <span>
                                                <i class="bi bi-person me-1"></i>
                                                @movement.CreatedBy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@movement.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Voir les détails">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-arrow-left-right display-4 text-muted"></i>

                    <h5 class="mt-3">
                        Aucun mouvement enregistré
                    </h5>

                    <p class="text-muted">
                        Les mouvements apparaîtront automatiquement
                        lors des entrées et sorties de stock.
                    </p>

                    <a asp-controller="Inventory"
                       asp-action="Index"
                       class="btn btn-primary">

                        <i class="bi bi-boxes me-1"></i>
                        Voir l'inventaire

                    </a>

                </div>
            }

        </div>
    </div>

</div>