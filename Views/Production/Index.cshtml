@model IEnumerable<FerticaStockManagement.Models.ProductionOrder>

@{
    ViewData["Title"] = "Production";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Production</h1>
        <p class="page-subtitle">
            Gestion des ordres de production
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Nouvel ordre
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>N° commande</th>
                            <th>Produit</th>
                            <th>Quantité planifiée</th>
                            <th>Quantité produite</th>
                            <th>Date prévue</th>
                            <th>Statut</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var production in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @production.OrderNumber
                                    </strong>
                                </td>

                                <td>
                                    @if (production.Product != null)
                                    {
                                        @production.Product.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Produit inconnu
                                        </span>
                                    }
                                </td>

                                <td>
                                    @production.PlannedQuantity
                                </td>

                                <td>
                                    @production.ProducedQuantity
                                </td>

                                <td>
                                    @production.PlannedDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @if (production.Status == "Terminée")
                                    {
                                        <span class="badge bg-success">
                                            Terminée
                                        </span>
                                    }
                                    else if (production.Status == "En cours")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            En cours
                                        </span>
                                    }
                                    else if (production.Status == "Annulée")
                                    {
                                        <span class="badge bg-danger">
                                            Annulée
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @production.Status
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-gear-wide-connected fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Aucun ordre de production
                </h5>

                <p class="text-muted">
                    Aucun ordre de production n'a encore été créé.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    Créer un ordre
                </a>

            </div>
        }

    </div>
</div>