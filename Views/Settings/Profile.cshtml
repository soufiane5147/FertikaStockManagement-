@using Microsoft.AspNetCore.Identity
@inject UserManager<FerticaStockManagement.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Mon profil";

    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="page-header mb-4">

    <div>
        <h1 class="page-title">
            <i class="bi bi-person-circle"></i>
            Mon profil
        </h1>

        <p class="text-muted">
            Informations de votre compte.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Retour

    </a>

</div>


<div class="card shadow-sm">

    <div class="card-body">

        @if (currentUser != null)
        {
            <div class="row g-4">

                <!-- Prénom -->

                <div class="col-md-6">

                    <label class="form-label">
                        Prénom
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@currentUser.FirstName"
                           readonly />

                </div>


                <!-- Nom -->

                <div class="col-md-6">

                    <label class="form-label">
                        Nom
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@currentUser.LastName"
                           readonly />

                </div>


                <!-- Email -->

                <div class="col-md-6">

                    <label class="form-label">
                        Adresse e-mail
                    </label>

                    <input type="email"
                           class="form-control"
                           value="@currentUser.Email"
                           readonly />

                </div>


                <!-- Téléphone -->

                <div class="col-md-6">

                    <label class="form-label">
                        Téléphone
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@currentUser.PhoneNumber"
                           readonly />

                </div>


                <!-- Nom complet -->

                <div class="col-12">

                    <label class="form-label">
                        Nom complet
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@currentUser.FullName"
                           readonly />

                </div>

            </div>
        }
        else
        {
            <div class="alert alert-warning">
                Impossible de récupérer les informations du compte.
            </div>
        }

    </div>

</div>