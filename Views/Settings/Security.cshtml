@{
    ViewData["Title"] = "Sécurité";
}

<div class="page-header mb-4">

    <div>
        <h1 class="page-title">
            <i class="bi bi-shield-lock"></i>
            Sécurité
        </h1>

        <p class="text-muted">
            Paramètres de sécurité de votre compte.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Retour

    </a>

</div>


<div class="row g-4">

    <!-- Mot de passe -->

    <div class="col-md-6">

        <div class="card h-100 shadow-sm">

            <div class="card-body">

                <div class="mb-3">
                    <i class="bi bi-key fs-1"></i>
                </div>

                <h5 class="card-title">
                    Mot de passe
                </h5>

                <p class="text-muted">
                    Pour modifier votre mot de passe,
                    utilisez l'option ci-dessous.
                </p>

                <a asp-controller="Account"
                   asp-action="ChangePassword"
                   class="btn btn-success">

                    <i class="bi bi-key"></i>
                    Modifier le mot de passe

                </a>

            </div>

        </div>

    </div>


    <!-- Compte -->

    <div class="col-md-6">

        <div class="card h-100 shadow-sm">

            <div class="card-body">

                <div class="mb-3">
                    <i class="bi bi-shield-check fs-1"></i>
                </div>

                <h5 class="card-title">
                    Sécurité du compte
                </h5>

                <p class="text-muted">
                    Votre compte est protégé par
                    ASP.NET Core Identity.
                </p>

                <div class="alert alert-success mb-0">

                    <i class="bi bi-check-circle"></i>

                    Authentification sécurisée activée.

                </div>

            </div>

        </div>

    </div>

</div>