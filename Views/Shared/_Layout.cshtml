@using Microsoft.AspNetCore.Identity
@using FerticaStockManagement.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Fertica Stock Management</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

@if (SignInManager.IsSignedIn(User))
{
    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <div>
                <div class="brand-title">FERTICA</div>
                <div class="brand-subtitle">Stock Management</div>
            </div>
        </div>

        <nav class="sidebar-nav">

            <div class="nav-section-title">PRINCIPAL</div>

            <a asp-controller="Home"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-house"></i>
                <span>Accueil</span>
            </a>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </a>


            <div class="nav-section-title">GESTION</div>

            <a asp-controller="Suppliers"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-truck"></i>
                <span>Fournisseurs</span>
            </a>

            <a asp-controller="RawMaterials"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-boxes"></i>
                <span>Matières premières</span>
            </a>

            <a asp-controller="Categories"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-tags"></i>
                <span>Catégories</span>
            </a>

            <a asp-controller="Products"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-box"></i>
                <span>Produits</span>
            </a>


            <div class="nav-section-title">PRODUCTION</div>

            <a asp-controller="ProductionOrders"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-clipboard-check"></i>
                <span>Ordres de production</span>
            </a>

            <a asp-controller="Production"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-gear-wide-connected"></i>
                <span>Production</span>
            </a>


            <div class="nav-section-title">STOCK</div>

            <a asp-controller="Inventory"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-bar-chart"></i>
                <span>Inventaire</span>
            </a>

            <a asp-controller="StockEntries"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-box-arrow-in-down"></i>
                <span>Entrées stock</span>
            </a>

            <a asp-controller="StockOutputs"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-box-arrow-up"></i>
                <span>Sorties stock</span>
            </a>

            <a asp-controller="StockMovements"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-arrow-left-right"></i>
                <span>Mouvements</span>
            </a>


            <div class="nav-section-title">RAPPORTS</div>

            <a asp-controller="Reports"
               asp-action="Index"
               class="nav-link-custom">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Rapports</span>
            </a>


            @if (User.IsInRole("Administrator"))
            {
                <div class="nav-section-title">ADMINISTRATION</div>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="nav-link-custom">
                    <i class="bi bi-people"></i>
                    <span>Utilisateurs</span>
                </a>

                <a asp-controller="Roles"
                   asp-action="Index"
                   class="nav-link-custom">
                    <i class="bi bi-shield-lock"></i>
                    <span>Rôles</span>
                </a>

                <a asp-controller="Settings"
                   asp-action="Index"
                   class="nav-link-custom">
                    <i class="bi bi-gear"></i>
                    <span>Paramètres</span>
                </a>
            }

        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-status">
                <span class="status-dot"></span>
                Système opérationnel
            </div>
        </div>

    </aside>


    <!-- MAIN AREA -->
    <div class="main-wrapper">

        <!-- TOPBAR -->
        <header class="topbar">

            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-title">
                @ViewData["Title"]
            </div>

            <div class="topbar-actions">

                <button class="icon-button" title="Notifications">
                    <i class="bi bi-bell"></i>
                </button>

                <div class="user-menu">

                    <div class="user-avatar">
                        @{
                            var currentUser = await UserManager.GetUserAsync(User);
                            var initials = currentUser != null
                                ? $"{currentUser.FirstName.FirstOrDefault()}{currentUser.LastName.FirstOrDefault()}"
                                : "U";
                        }

                        @initials.ToUpper()
                    </div>

                    <div class="user-info">
                        <strong>
                            @(currentUser?.FullName ?? User.Identity?.Name)
                        </strong>

                        <small>
                            @if (User.IsInRole("Administrator"))
                            {
                                <span>Administrateur</span>
                            }
                            else
                            {
                                <span>Employé</span>
                            }
                        </small>
                    </div>

                    <div class="dropdown">
                        <button class="btn dropdown-toggle user-dropdown"
                                data-bs-toggle="dropdown">
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Settings"
                                   asp-action="Profile">
                                    <i class="bi bi-person me-2"></i>
                                    Mon profil
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Settings"
                                   asp-action="Security">
                                    <i class="bi bi-shield-check me-2"></i>
                                    Sécurité
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Déconnexion
                                    </button>

                                </form>
                            </li>

                        </ul>
                    </div>

                </div>

            </div>

        </header>


        <!-- PAGE CONTENT -->
        <main class="content">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle me-2"></i>
                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>
                </div>
            }

            @RenderBody()

        </main>

    </div>
}
else
{
    <main>
        @RenderBody()
    </main>
}


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>