@model FerticaStockManagement.Models.Supplier

@{
    ViewData["Title"] = "Détails fournisseur";
}

<div class="page-header">

    <div>
        <h1>@Model.Name</h1>
        <p>Détails du fournisseur.</p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            <i class="bi bi-pencil me-2"></i>
            Modifier
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Retour
        </a>

    </div>

</div>

<div class="row g-4 mt-2">

    <div class="col-lg-8">

        <div class="card">

            <div class="card-header p-3">
                <h5 class="mb-0">
                    Informations générales
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Nom</small>
                        <div class="fw-semibold">
                            @Model.Name
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Contact</small>
                        <div class="fw-semibold">
                            @(Model.ContactPerson ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Email</small>
                        <div>
                            @(Model.Email ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Téléphone</small>
                        <div>
                            @(Model.Phone ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Ville</small>
                        <div>
                            @(Model.City ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <small class="text-muted">Pays</small>
                        <div>
                            @(Model.Country ?? "-")
                        </div>
                    </div>

                    <div class="col-12 mb-2">
                        <small class="text-muted">Adresse</small>
                        <div>
                            @(Model.Address ?? "-")
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-lg-4">

        <div class="card">

            <div class="card-header p-3">
                <h5 class="mb-0">
                    Statut
                </h5>
            </div>

            <div class="card-body">

                @if (Model.IsActive)
                {
                    <span class="badge bg-success-subtle text-success fs-6">
                        <i class="bi bi-check-circle me-1"></i>
                        Actif
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary fs-6">
                        Inactif
                    </span>
                }

                <hr />

                <small class="text-muted">
                    Fournisseur créé le
                </small>

                <div class="fw-semibold mt-1">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </div>

                <hr />

                <small class="text-muted">
                    Matières premières associées
                </small>

                <div class="fs-3 fw-bold mt-1">
                    @(Model.RawMaterials?.Count ?? 0)
                </div>

            </div>

        </div>

    </div>

</div>