@model FerticaStockManagement.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Nouveau fournisseur";
}

<div class="page-header">

    <div>
        <h1>Nouveau fournisseur</h1>
        <p>Ajouter un fournisseur à la base de données.</p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Retour
    </a>

</div>

<div class="card mt-4">

    <div class="card-header p-3">
        <h5 class="mb-0">
            <i class="bi bi-truck me-2"></i>
            Informations du fournisseur
        </h5>
    </div>

    <div class="card-body p-4">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Nom du fournisseur *
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Nom du fournisseur" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="ContactPerson"
                           class="form-label">
                        Personne de contact
                    </label>

                    <input asp-for="ContactPerson"
                           class="form-control"
                           placeholder="Nom du contact" />

                    <span asp-validation-for="ContactPerson"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="fournisseur@example.com" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Phone"
                           class="form-label">
                        Téléphone
                    </label>

                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="+212 ..." />

                    <span asp-validation-for="Phone"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-12 mb-3">

                    <label asp-for="Address"
                           class="form-label">
                        Adresse
                    </label>

                    <input asp-for="Address"
                           class="form-control"
                           placeholder="Adresse du fournisseur" />

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="City"
                           class="form-label">
                        Ville
                    </label>

                    <input asp-for="City"
                           class="form-control"
                           placeholder="Ville" />

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Country"
                           class="form-label">
                        Pays
                    </label>

                    <input asp-for="Country"
                           class="form-control"
                           value="Maroc" />

                </div>

                <div class="col-12 mb-4">

                    <div class="form-check">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Fournisseur actif
                        </label>

                    </div>

                </div>

            </div>

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">
                    Annuler
                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-2"></i>
                    Enregistrer

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}