@model FerticaStockManagement.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Modifier le fournisseur";
}

<div class="page-header">

    <div>
        <h1>Modifier le fournisseur</h1>
        <p>Mettre à jour les informations du fournisseur.</p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Retour
    </a>

</div>

<div class="card mt-4">

    <div class="card-body p-4">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Nom *
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="ContactPerson"
                           class="form-label">
                        Personne de contact
                    </label>

                    <input asp-for="ContactPerson"
                           class="form-control" />

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Phone"
                           class="form-label">
                        Téléphone
                    </label>

                    <input asp-for="Phone"
                           class="form-control" />

                </div>

                <div class="col-12 mb-3">

                    <label asp-for="Address"
                           class="form-label">
                        Adresse
                    </label>

                    <input asp-for="Address"
                           class="form-control" />

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="City"
                           class="form-label">
                        Ville
                    </label>

                    <input asp-for="City"
                           class="form-control" />

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Country"
                           class="form-label">
                        Pays
                    </label>

                    <input asp-for="Country"
                           class="form-control" />

                </div>

                <div class="col-12 mb-4">

                    <div class="form-check">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Fournisseur actif
                        </label>

                    </div>

                </div>

            </div>

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">
                    Annuler
                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save me-2"></i>
                    Enregistrer les modifications

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}