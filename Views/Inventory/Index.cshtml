@model FerticaStockManagement.ViewModels.InventoryViewModel

@{
    ViewData["Title"] = "Inventaire";
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-boxes"></i>
            Inventaire
        </h1>

        <p class="page-subtitle">
            Suivi des stocks de matières premières et produits
        </p>
    </div>
</div>


<!-- ========================= -->
<!-- STATISTIQUES -->
<!-- ========================= -->

<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <small class="text-muted">
                            Matières premières
                        </small>

                        <h3 class="mt-1 mb-0">
                            @Model.RawMaterials.Count
                        </h3>
                    </div>

                    <div class="fs-1 text-muted">
                        <i class="bi bi-box-seam"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <small class="text-muted">
                            Produits
                        </small>

                        <h3 class="mt-1 mb-0">
                            @Model.Products.Count
                        </h3>
                    </div>

                    <div class="fs-1 text-muted">
                        <i class="bi bi-boxes"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <small class="text-muted">
                            Mouvements récents
                        </small>

                        <h3 class="mt-1 mb-0">
                            @Model.RecentMovements.Count
                        </h3>
                    </div>

                    <div class="fs-1 text-muted">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>


<!-- ========================= -->
<!-- MATIÈRES PREMIÈRES -->
<!-- ========================= -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-1">
                    <i class="bi bi-box-seam"></i>
                    Stock des matières premières
                </h5>

                <small class="text-muted">
                    État actuel des matières premières disponibles
                </small>
            </div>

            <span class="badge bg-secondary">
                @Model.RawMaterials.Count article(s)
            </span>

        </div>

    </div>


    <div class="card-body">

        @if (Model.RawMaterials.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Matière première</th>
                            <th>Unité</th>
                            <th>Stock actuel</th>
                            <th>Stock minimum</th>
                            <th>Prix unitaire</th>
                            <th>État</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var material in Model.RawMaterials)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @material.Code
                                    </strong>
                                </td>

                                <td>
                                    @material.Name
                                </td>

                                <td>
                                    @material.Unit
                                </td>

                                <td>
                                    <strong>
                                        @material.CurrentStock
                                    </strong>
                                </td>

                                <td>
                                    @material.MinimumStock
                                </td>

                                <td>
                                    @material.UnitPrice.ToString("N2")
                                </td>

                                <td>

                                    @if (material.IsLowStock)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            Stock faible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            Normal
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-box-seam"
                   style="font-size: 3rem; opacity: .4;"></i>

                <h5 class="mt-3">
                    Aucune matière première
                </h5>

                <p class="text-muted mb-0">
                    Aucune matière première active n'est disponible.
                </p>

            </div>
        }

    </div>

</div>


<!-- ========================= -->
<!-- PRODUITS -->
<!-- ========================= -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-1">
                    <i class="bi bi-boxes"></i>
                    Stock des produits
                </h5>

                <small class="text-muted">
                    État actuel des produits finis
                </small>
            </div>

            <span class="badge bg-secondary">
                @Model.Products.Count produit(s)
            </span>

        </div>

    </div>


    <div class="card-body">

        @if (Model.Products.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Produit</th>
                            <th>Unité</th>
                            <th>Stock actuel</th>
                            <th>Stock minimum</th>
                            <th>Prix de vente</th>
                            <th>État</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var product in Model.Products)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @product.Code
                                    </strong>
                                </td>

                                <td>
                                    @product.Name
                                </td>

                                <td>
                                    @product.Unit
                                </td>

                                <td>
                                    <strong>
                                        @product.CurrentStock
                                    </strong>
                                </td>

                                <td>
                                    @product.MinimumStock
                                </td>

                                <td>
                                    @product.SellingPrice.ToString("N2")
                                </td>

                                <td>

                                    @if (product.IsLowStock)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            Stock faible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            Normal
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-boxes"
                   style="font-size: 3rem; opacity: .4;"></i>

                <h5 class="mt-3">
                    Aucun produit
                </h5>

                <p class="text-muted mb-0">
                    Aucun produit actif n'est disponible.
                </p>

            </div>
        }

    </div>

</div>


<!-- ========================= -->
<!-- MOUVEMENTS RÉCENTS -->
<!-- ========================= -->

<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">

        <div>
            <h5 class="mb-1">
                <i class="bi bi-arrow-left-right"></i>
                Mouvements récents
            </h5>

            <small class="text-muted">
                Les 10 derniers mouvements de stock
            </small>
        </div>

    </div>


    <div class="card-body">

        @if (Model.RecentMovements.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Article</th>
                            <th>Type</th>
                            <th>Quantité</th>
                            <th>Stock avant</th>
                            <th>Stock après</th>
                            <th>Date</th>
                            <th>Créé par</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var movement in Model.RecentMovements)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @movement.Reference
                                    </strong>
                                </td>

                                <td>
                                    @movement.ItemName
                                </td>

                                <td>

                                    @if (movement.MovementType == "Entrée")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-arrow-down"></i>
                                            Entrée
                                        </span>
                                    }
                                    else if (movement.MovementType == "Sortie")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-arrow-up"></i>
                                            Sortie
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @movement.MovementType
                                        </span>
                                    }

                                </td>

                                <td>
                                    @movement.Quantity
                                </td>

                                <td>
                                    @movement.StockBefore
                                </td>

                                <td>
                                    <strong>
                                        @movement.StockAfter
                                    </strong>
                                </td>

                                <td>
                                    @movement.MovementDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @(movement.CreatedBy ?? "-")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-arrow-left-right"
                   style="font-size: 3rem; opacity: .4;"></i>

                <h5 class="mt-3">
                    Aucun mouvement
                </h5>

                <p class="text-muted mb-0">
                    Aucun mouvement de stock n'a encore été enregistré.
                </p>

            </div>
        }

    </div>

</div>