@model FerticaStockManagement.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Nouveau produit";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nouveau produit</h1>
        <p class="page-subtitle">Ajouter un produit au catalogue</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        Retour
    </a>
</div>

<div class="card">
    <div class="card-body">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row g-4">

                <div class="col-md-6">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code"
                           class="form-control"
                           placeholder="Ex : PROD-001" />
                    <span asp-validation-for="Code"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Nom du produit" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label">
                        Catégorie
                    </label>

                    <select asp-for="CategoryId"
                            class="form-select"
                            asp-items="ViewBag.Categories">
                        <option value="">-- Sélectionner une catégorie --</option>
                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Unit" class="form-label"></label>

                    <select asp-for="Unit" class="form-select">
                        <option value="">-- Sélectionner --</option>
                        <option value="kg">kg</option>
                        <option value="tonne">tonne</option>
                        <option value="unité">unité</option>
                        <option value="sac">sac</option>
                        <option value="litre">litre</option>
                    </select>

                    <span asp-validation-for="Unit"
                          class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Description" class="form-label"></label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Description du produit"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CurrentStock" class="form-label">
                        Stock initial
                    </label>

                    <input asp-for="CurrentStock"
                           class="form-control"
                           type="number"
                           step="0.001"
                           min="0" />

                    <span asp-validation-for="CurrentStock"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MinimumStock" class="form-label">
                        Stock minimum
                    </label>

                    <input asp-for="MinimumStock"
                           class="form-control"
                           type="number"
                           step="0.001"
                           min="0" />

                    <span asp-validation-for="MinimumStock"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="SellingPrice" class="form-label">
                        Prix de vente
                    </label>

                    <div class="input-group">
                        <input asp-for="SellingPrice"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0" />
                        <span class="input-group-text">DH</span>
                    </div>

                    <span asp-validation-for="SellingPrice"
                          class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Produit actif
                        </label>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Annuler
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Enregistrer
                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}