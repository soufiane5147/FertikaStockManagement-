@model IEnumerable<FerticaStockManagement.Models.Product>

@{
    ViewData["Title"] = "Produits";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Produits</h1>
        <p class="page-subtitle">Gestion des produits finis</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Nouveau produit
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Nom</th>
                        <th>Catégorie</th>
                        <th>Unité</th>
                        <th>Stock</th>
                        <th>Stock minimum</th>
                        <th>Prix de vente</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            var lowStock = product.CurrentStock <= product.MinimumStock;

                            <tr>
                                <td>
                                    <strong>@product.Code</strong>
                                </td>

                                <td>
                                    @product.Name
                                </td>

                                <td>
                                    @(product.Category?.Name ?? "Sans catégorie")
                                </td>

                                <td>
                                    @product.Unit
                                </td>

                                <td>
                                    <span class="@(lowStock ? "text-danger fw-bold" : "fw-semibold")">
                                        @product.CurrentStock
                                    </span>
                                </td>

                                <td>
                                    @product.MinimumStock
                                </td>

                                <td>
                                    @product.SellingPrice.ToString("N2") DH
                                </td>

                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="badge bg-success">Actif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactif</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="Delete"
      asp-route-id="@product.Id"
      method="post"
      style="display:inline;">

    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-sm btn-outline-danger"
            title="Désactiver"
            onclick="return confirm('Voulez-vous vraiment désactiver ce produit ?');">
        <i class="bi bi-trash"></i>
    </button>

</form>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <i class="bi bi-box-seam fs-1 text-muted"></i>
                                <p class="mt-3 mb-0 text-muted">
                                    Aucun produit enregistré.
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>