@model IEnumerable<FerticaStockManagement.Models.Report>

@{
    ViewData["Title"] = "Rapports";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title mb-1">
                <i class="bi bi-file-earmark-bar-graph me-2"></i>
                Rapports
            </h1>
            <p class="text-muted mb-0">
                Consultez les rapports générés du système.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nouveau rapport
        </a>
    </div>


    <div class="card shadow-sm border-0">

        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    Historique des rapports
                </h5>

                <span class="badge bg-secondary">
                    @Model.Count() rapport(s)
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Titre</th>
                                <th>Type</th>
                                <th>Période</th>
                                <th>Généré le</th>
                                <th>Généré par</th>
                                <th class="text-end">Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var report in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            @report.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(report.Description))
                                        {
                                            <small class="text-muted">
                                                @report.Description
                                            </small>
                                        }
                                    </td>


                                    <td>
                                        <span class="badge bg-primary">
                                            @report.Type
                                        </span>
                                    </td>


                                    <td>
                                        <div>
                                            @report.StartDate.ToString("dd/MM/yyyy")
                                        </div>

                                        <small class="text-muted">
                                            au @report.EndDate.ToString("dd/MM/yyyy")
                                        </small>
                                    </td>


                                    <td>
                                        @report.GeneratedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>


                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(report.GeneratedBy))
                                        {
                                            <span>
                                                <i class="bi bi-person me-1"></i>
                                                @report.GeneratedBy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>


                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@report.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Voir le rapport">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-file-earmark-bar-graph display-4 text-muted"></i>

                    <h5 class="mt-3">
                        Aucun rapport
                    </h5>

                    <p class="text-muted">
                        Aucun rapport n'a encore été généré.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Créer un rapport

                    </a>

                </div>
            }

        </div>

    </div>

</div>