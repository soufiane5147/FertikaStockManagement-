@model FerticaStockManagement.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Nouveau rapport";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="page-title mb-1">
                <i class="bi bi-file-earmark-plus me-2"></i>
                Nouveau rapport
            </h1>

            <p class="text-muted mb-0">
                Configurez les paramètres du rapport.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Retour

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white border-bottom py-3">

                    <h5 class="mb-0">
                        <i class="bi bi-sliders me-2"></i>
                        Paramètres du rapport
                    </h5>

                </div>


                <div class="card-body">

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>


                        <!-- Titre -->
                        <div class="mb-3">

                            <label asp-for="Title"
                                   class="form-label">
                                <i class="bi bi-type me-1"></i>
                                Titre
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Ex. Rapport mensuel du stock" />

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>

                        </div>


                        <!-- Type -->
                        <div class="mb-3">

                            <label asp-for="Type"
                                   class="form-label">
                                <i class="bi bi-tag me-1"></i>
                                Type de rapport
                            </label>

                            <select asp-for="Type"
                                    class="form-select">

                                <option value="">
                                    -- Sélectionner un type --
                                </option>

                                <option value="Stock">
                                    Rapport de stock
                                </option>

                                <option value="Production">
                                    Rapport de production
                                </option>

                                <option value="Mouvements">
                                    Rapport des mouvements
                                </option>

                                <option value="Fournisseurs">
                                    Rapport des fournisseurs
                                </option>

                                <option value="Global">
                                    Rapport global
                                </option>

                            </select>

                            <span asp-validation-for="Type"
                                  class="text-danger"></span>

                        </div>


                        <div class="row">

                            <!-- Date début -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="StartDate"
                                       class="form-label">

                                    <i class="bi bi-calendar-event me-1"></i>
                                    Date début

                                </label>

                                <input asp-for="StartDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="StartDate"
                                      class="text-danger"></span>

                            </div>


                            <!-- Date fin -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="EndDate"
                                       class="form-label">

                                    <i class="bi bi-calendar-check me-1"></i>
                                    Date fin

                                </label>

                                <input asp-for="EndDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="EndDate"
                                      class="text-danger"></span>

                            </div>

                        </div>


                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label">

                                <i class="bi bi-card-text me-1"></i>
                                Description

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Ajoutez une description du rapport..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>

                        </div>


                        <div class="alert alert-info">

                            <i class="bi bi-info-circle me-2"></i>

                            Le rapport sera enregistré avec la période
                            sélectionnée et l'utilisateur connecté.

                        </div>


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Annuler

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>
                                Générer le rapport

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}