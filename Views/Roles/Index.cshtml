@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{ ViewData["Title"] = "Rôles"; }
<div class="container-fluid"><div class="d-flex justify-content-between mb-4"><h1>Rôles</h1><a asp-action="Create" class="btn btn-primary">+ Ajouter</a></div><table class="table"><thead><tr><th>Nom</th><th>Actions</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Name</td><td><form asp-action="Delete" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><button class="btn btn-sm btn-danger">Supprimer</button></form></td></tr>}</tbody></table></div>
