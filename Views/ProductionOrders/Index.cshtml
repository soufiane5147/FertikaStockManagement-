@model IEnumerable<FerticaStockManagement.Models.ProductionOrder>

@{
    ViewData["Title"] = "Ordres de production";
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-gear-wide-connected"></i>
            Ordres de production
        </h1>
        <p class="page-subtitle">
            Suivi des ordres de production
        </p>
    </div>

    <a asp-controller="Production"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Nouvel ordre
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Numéro</th>
                            <th>Produit</th>
                            <th>Qté planifiée</th>
                            <th>Qté produite</th>
                            <th>Date prévue</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@order.OrderNumber</strong>
                                </td>

                                <td>
                                    @(order.Product?.Name ?? "Non défini")
                                </td>

                                <td>
                                    @order.PlannedQuantity
                                    @(order.Product?.Unit ?? "")
                                </td>

                                <td>
                                    @order.ProducedQuantity
                                    @(order.Product?.Unit ?? "")
                                </td>

                                <td>
                                    @order.PlannedDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @switch (order.Status)
                                    {
                                        case "En attente":
                                            <span class="badge bg-secondary">
                                                En attente
                                            </span>
                                            break;

                                        case "Planifiée":
                                            <span class="badge bg-info text-dark">
                                                Planifiée
                                            </span>
                                            break;

                                        case "En cours":
                                            <span class="badge bg-warning text-dark">
                                                En cours
                                            </span>
                                            break;

                                        case "Terminée":
                                            <span class="badge bg-success">
                                                Terminée
                                            </span>
                                            break;

                                        case "Annulée":
                                            <span class="badge bg-danger">
                                                Annulée
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary">
                                                @order.Status
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Détails">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-gear-wide-connected"
                   style="font-size: 3rem; opacity: .4;"></i>

                <h5 class="mt-3">
                    Aucun ordre de production
                </h5>

                <p class="text-muted">
                    Aucun ordre de production n'a encore été créé.
                </p>

                <a asp-controller="Production"
                   asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Créer un ordre
                </a>

            </div>
        }

    </div>
</div>