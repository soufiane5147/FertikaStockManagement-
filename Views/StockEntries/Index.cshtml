@model IEnumerable<FerticaStockManagement.Models.StockEntry>

@{
    ViewData["Title"] = "Entrées de stock";
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-box-arrow-in-down"></i>
            Entrées de stock
        </h1>
        <p class="page-subtitle">
            Gestion des entrées de matières premières
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Nouvelle entrée
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Matière première</th>
                            <th>Fournisseur</th>
                            <th>Quantité</th>
                            <th>Prix unitaire</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th>Créé par</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var entry in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@entry.Reference</strong>
                                </td>

                                <td>
                                    @(entry.RawMaterial?.Name ?? "Non définie")
                                </td>

                                <td>
                                    @(entry.Supplier?.Name ?? "Non défini")
                                </td>

                                <td>
                                    @entry.Quantity
                                    @(entry.RawMaterial?.Unit ?? "")
                                </td>

                                <td>
                                    @entry.UnitPrice.ToString("N2")
                                </td>

                                <td>
                                    <strong>
                                        @entry.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @entry.EntryDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @(entry.CreatedBy ?? "-")
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@entry.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Voir les détails">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-box-arrow-in-down"
                   style="font-size: 3rem; opacity: .4;"></i>

                <h5 class="mt-3">
                    Aucune entrée de stock
                </h5>

                <p class="text-muted">
                    Aucune entrée de matière première n'a encore été enregistrée.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Ajouter une entrée
                </a>

            </div>
        }

    </div>
</div>