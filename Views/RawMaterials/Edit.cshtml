@model FerticaStockManagement.ViewModels.RawMaterialViewModel

@{
    ViewData["Title"] = "Modifier la matière première";
}

<div class="page-header">
    <div>
        <h1>Modifier la matière première</h1>
        <p>Modifier les informations de cette matière première.</p>
    </div>

    <a asp-action="Index" class="btn btn-light">
        <i class="bi bi-arrow-left"></i>
        Retour
    </a>
</div>

<div class="content-card form-card">

    <form asp-action="Edit" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="row g-4">

            <div class="col-md-6">
                <label asp-for="Code" class="form-label">
                    Code
                </label>

                <input asp-for="Code"
                       class="form-control" />

                <span asp-validation-for="Code"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label">
                    Nom
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Type" class="form-label">
                    Type
                </label>

                <input asp-for="Type"
                       class="form-control" />

                <span asp-validation-for="Type"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Unit" class="form-label">
                    Unité
                </label>

                <input asp-for="Unit"
                       class="form-control" />

                <span asp-validation-for="Unit"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CurrentStock" class="form-label">
                    Stock actuel
                </label>

                <input asp-for="CurrentStock"
                       type="number"
                       step="0.01"
                       class="form-control" />

                <span asp-validation-for="CurrentStock"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="MinimumStock" class="form-label">
                    Stock minimum
                </label>

                <input asp-for="MinimumStock"
                       type="number"
                       step="0.01"
                       class="form-control" />

                <span asp-validation-for="MinimumStock"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="UnitPrice" class="form-label">
                    Prix unitaire
                </label>

                <div class="input-group">

                    <input asp-for="UnitPrice"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span class="input-group-text">DH</span>

                </div>

                <span asp-validation-for="UnitPrice"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SupplierId" class="form-label">
                    Fournisseur
                </label>

                <select asp-for="SupplierId"
                        class="form-select">

                    <option value="">
                        -- Sélectionner un fournisseur --
                    </option>

                    @foreach (var supplier in ViewBag.Suppliers)
                    {
                        <option value="@supplier.Id">
                            @supplier.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="SupplierId"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="IsActive" class="form-label">
                    Statut
                </label>

                <select asp-for="IsActive"
                        class="form-select">

                    <option value="true">Actif</option>
                    <option value="false">Inactif</option>

                </select>
            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="btn btn-light">
                Annuler
            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-lg"></i>
                Enregistrer les modifications

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}