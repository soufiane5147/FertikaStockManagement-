@model FerticaStockManagement.Models.RawMaterial

@{
    ViewData["Title"] = "Détails matière première";

    var lowStock = Model.CurrentStock <= Model.MinimumStock;
}

<div class="page-header">

    <div>
        <h1>Détails de la matière première</h1>
        <p>Informations et état du stock.</p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">

            <i class="bi bi-pencil"></i>
            Modifier

        </a>

        <a asp-action="Index"
           class="btn btn-light">

            <i class="bi bi-arrow-left"></i>
            Retour

        </a>

    </div>

</div>

<div class="row g-4">

    <div class="col-lg-8">

        <div class="content-card">

            <h5 class="mb-4">
                <i class="bi bi-box-seam"></i>
                Informations générales
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <span class="detail-label">Code</span>
                    <strong>@Model.Code</strong>
                </div>

                <div class="col-md-6">
                    <span class="detail-label">Nom</span>
                    <strong>@Model.Name</strong>
                </div>

                <div class="col-md-6">
                    <span class="detail-label">Type</span>
                    <span>@(Model.Type ?? "—")</span>
                </div>

                <div class="col-md-6">
                    <span class="detail-label">Unité</span>
                    <span>@Model.Unit</span>
                </div>

                <div class="col-md-6">
                    <span class="detail-label">Fournisseur</span>
                    <span>
                        @(Model.Supplier?.Name ?? "—")
                    </span>
                </div>

                <div class="col-md-6">
                    <span class="detail-label">Prix unitaire</span>
                    <span>
                        @Model.UnitPrice.ToString("N2") DH
                    </span>
                </div>

                <div class="col-md-6">
                    <span class="detail-label">Date de création</span>
                    <span>
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="col-md-6">
                    <span class="detail-label">Statut</span>

                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">
                            Actif
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">
                            Inactif
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="content-card">

            <h5 class="mb-4">
                <i class="bi bi-bar-chart"></i>
                État du stock
            </h5>

            <div class="stock-detail">

                <span>Stock actuel</span>

                <strong class="stock-value @(lowStock ? "text-danger" : "")">
                    @Model.CurrentStock @Model.Unit
                </strong>

            </div>

            <div class="stock-detail">

                <span>Stock minimum</span>

                <strong>
                    @Model.MinimumStock @Model.Unit
                </strong>

            </div>

            @if (lowStock)
            {
                <div class="alert alert-warning mt-4 mb-0">

                    <i class="bi bi-exclamation-triangle"></i>

                    Le stock est inférieur ou égal au seuil minimum.

                </div>
            }
            else
            {
                <div class="alert alert-success mt-4 mb-0">

                    <i class="bi bi-check-circle"></i>

                    Niveau de stock normal.

                </div>
            }

        </div>

    </div>

</div>